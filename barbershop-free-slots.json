      "id": "6fc5ee21-f56e-4a2a-bf15-c7d403f4ec49",
      "name": "Get Free Busy",
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "Google Calendar OAuth2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Inputs from \"Set Parameters\"\nconst params = $('Set Parameters').first().json;\nconst { start, end, workStart, workEnd } = params;\nconst serviceId = params.service;\n\n// Service duration (minutes) from the \"Services\" table\nconst services = $('Aggregate Services').first().json.data || [];\nconst service = services.find(\n  (s) => String(s.id) === String(serviceId) || (s.fields && String(s.fields['Record ID']) === String(serviceId))\n);\nif (!service) {\n  throw new Error(`Service \"${serviceId}\" was not found in the Services table`);\n}\nconst duration = Number(service.fields['Duration, min']);\n\n// Busy periods per calendar from the Google Calendar freeBusy API\nconst freeBusy = $('Get Free Busy').first().json;\nconst calendars = freeBusy.calendars || {};\n\n// --- Time helpers -----------------------------------------------------------\n// All calculations use the UTC offset of the \"start\" string (e.g. +01:00).\n// A \"local\" date is a Date shifted by that offset and read with getUTC*() methods,\n// so the result does not depend on the server time zone.\nfunction parseOffsetMinutes(str) {\n  if (/Z$/.test(str)) return 0;\n  const m = str.match(/([+-])(\\d{2}):?(\\d{2})$/);\n  if (!m) return 0;\n  return (m[1] === '+' ? 1 : -1) * (Number(m[2]) * 60 + Number(m[3]));\n}\n\nconst OFFSET = parseOffsetMinutes(start);\nconst pad = (n) => String(n).padStart(2, '0');\nconst OFFSET_STR =\n  (OFFSET < 0 ? '-' : '+') + pad(Math.floor(Math.abs(OFFSET) / 60)) + ':' + pad(Math.abs(OFFSET) % 60);\n\nconst toLocal = (date) => new Date(date.getTime() + OFFSET * 60000);\n\nfunction format(local) {\n  return (\n    `${local.getUTCFullYear()}-${pad(local.getUTCMonth() + 1)}-${pad(local.getUTCDate())}` +\n    `T${pad(local.getUTCHours())}:${pad(local.getUTCMinutes())}:${pad(local.getUTCSeconds())}${OFFSET_STR}`\n  );\n}\n\n// --- Free windows for one calendar ------------------------------------------\nfunction getFreeWindows(busyPeriods) {\n  const rangeStart = toLocal(new Date(start));\n  const rangeEnd = toLocal(new Date(end));\n  const busy = busyPeriods\n    .map((b) => ({ start: toLocal(new Date(b.start)), end: toLocal(new Date(b.end)) }))\n    .sort((a, b) => a.start - b.start);\n\n  const result = [];\n  const DAY = 24 * 60 * 60 * 1000;\n  let day = new Date(Date.UTC(rangeStart.getUTCFullYear(), rangeStart.getUTCMonth(), rangeStart.getUTCDate()));\n\n  for (; day < rangeEnd; day = new Date(day.getTime() + DAY)) {\n    // Working hours of this day, limited to the requested range\n    const from = new Date(Math.max(day.getTime() + workStart * 3600000, rangeStart.getTime()));\n    const to = new Date(Math.min(day.getTime() + workEnd * 3600000, rangeEnd.getTime()));\n    if (from >= to) continue;\n\n    // Walk through the sorted busy periods; overlapping ones are merged naturally\n    let cursor = from;\n    for (const b of busy) {\n      if (b.end <= cursor) continue;\n      if (b.start >= to) break;\n      if (b.start > cursor) pushWindow(result, cursor, b.start);\n      if (b.end > cursor) cursor = b.end;\n      if (cursor >= to) break;\n    }\n    if (cursor < to) pushWindow(result, cursor, to);\n  }\n  return result;\n}\n\nfunction pushWindow(list, from, to) {\n  // Keep only windows long enough for the service\n  if (to.getTime() - from.getTime() >= duration * 60000) {\n    list.push({ 'slot start': format(from), 'slot end': format(to), duration });\n  }\n}\n\n// --- One result item per calendar (barber) ----------------------------------\nconst results = [];\nfor (const [calendarId, data] of Object.entries(calendars)) {\n  if (!data || typeof data !== 'object' || !('busy' in data)) continue;\n  results.push({ json: { calendar_id: calendarId, slots: getFreeWindows(data.busy || []) } });\n}\nreturn results;\n"
      },
