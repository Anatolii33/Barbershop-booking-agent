      "parameters": {
        "method": "POST",
        "url": "https://www.googleapis.com/calendar/v3/freeBusy",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleCalendarOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"timeMin\": \"{{ $('Set Parameters').item.json.start }}\",\n  \"timeMax\": \"{{ $('Set Parameters').item.json.end }}\",\n  \"timeZone\": \"{{ $('Set Parameters').item.json.timeZone }}\",\n  \"items\": {{ JSON.stringify($json.calendars) }}\n}",
